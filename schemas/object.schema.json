{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-ai-task-atlas.local/schema/object.schema.json",
  "title": "ObjectInstance",
  "type": "object",
  "required": ["id", "node_type", "canonical_name", "name_ja", "category", "general_concept_id", "affordances", "review_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "ycb_id": {"type": "string", "pattern": "^[0-9]{3}_[a-z0-9_]+$"},
    "asset_source": {"type": "string", "minLength": 1},
    "asset_source_version": {"type": "string", "minLength": 1},
    "asset_source_id": {"type": "string", "minLength": 1},
    "asset_source_url": {"type": "string", "minLength": 1, "pattern": "^https?://"},
    "source_taxonomy_url": {"type": "string", "minLength": 1, "pattern": "^https?://"},
    "asset_ready_in_source": {
      "type": "boolean",
      "description": "BEHAVIOR source readiness only; this does not establish asset compatibility."
    },
    "source_taxonomy": {
      "type": "object",
      "description": "Source taxonomy identity, independent of general_concept_id.",
      "required": ["source", "category_id", "synset_id"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "category_id": {"type": "string", "minLength": 1},
        "synset_id": {"type": "string", "minLength": 1},
        "parent_synset_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "node_type": {"type": "string", "enum": ["ObjectInstance"]},
    "canonical_name": {"type": "string", "minLength": 1},
    "name_ja": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "general_concept_id": {"type": "string"},
    "affordances": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "description": {"type": "string"},
    "review_status": {"type": "string", "enum": ["proposed", "reviewed", "deprecated"]}
  }
}
