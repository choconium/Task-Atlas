{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-ai-task-atlas.local/schema/task_instance.schema.json",
  "title": "TaskInstance",
  "type": "object",
  "required": [
    "id",
    "node_type",
    "template_id",
    "bindings",
    "object_id",
    "scene_id",
    "initial_state",
    "goal_state",
    "skills",
    "review_status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "node_type": { "type": "string", "enum": ["TaskInstance"] },
    "template_id": { "type": "string", "minLength": 1 },
    "bindings": {
      "type": "object",
      "properties": {
        "execution_asset_manifest_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Planning artifact that records the exact fixture composition, runtime, executed model identities, and configuration hashes for collection."
        },
        "execution_proxy_required": {
          "type": "boolean",
          "description": "Whether collection uses a movable execution proxy distinct from the catalog object identity."
        }
      }
    },
    "object_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "scene_id": { "type": "string", "minLength": 1 },
    "initial_state": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "goal_state": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "instruction_variants": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "review_status": {
      "type": "string",
      "enum": ["proposed", "reviewed", "deprecated"]
    }
  }
}
